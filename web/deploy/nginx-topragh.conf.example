# Example nginx for standalone topragh.ir Virtualmin vhost (not under hesabdaram)
server {
    listen 80;
    listen [::]:80;
    server_name topragh.ir www.topragh.ir;
    return 301 https://topragh.ir$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name topragh.ir www.topragh.ir;

    # Virtualmin typically injects ssl_certificate paths here
    root /home/topragh/public_html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    location /data/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /_astro/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
